<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <Title>SampSharp Server Core</Title>
    <Description>The core library of SampSharp which manages the communication with the SA-MP server.</Description>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PackageId>SampSharp.Core</PackageId>
    <Product>$(PackageId)</Product>
    <Version>0.10.1</Version>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="CodePages\data\*.dat" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.IO.Pipes" Version="4.3.0" />
    <PackageReference Include="System.Reflection.Emit" Version="4.3.0" />
    <PackageReference Include="System.Reflection.Emit.ILGeneration" Version="4.3.0" />
    <PackageReference Include="System.Threading.Thread" Version="4.3.0" />
  </ItemGroup>

</Project>